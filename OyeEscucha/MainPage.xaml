<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OyeEscucha.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#0F0F0F}">
    <Grid BackgroundColor="{AppThemeBinding Light=White, Dark=#0F0F0F}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,16,16,0" RowSpacing="10">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label x:Name="TitleLabel" Text="Mis Archivos" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}"/>
                    <Label x:Name="PathLabel" Text="/storage" FontSize="12" TextColor="{AppThemeBinding Light=#333333, Dark=#7EC8FF}" Opacity="0.7">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPathTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Toca la ruta para copiarla" FontSize="10" TextColor="{AppThemeBinding Light=#888888, Dark=#7EC8FF}" Opacity="0.4"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" x:Name="ThemeBtn" Text="🌙" FontSize="22" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" WidthRequest="50" HeightRequest="50" CornerRadius="25" VerticalOptions="Start" Clicked="OnThemeClicked"/>
            </Grid>
            <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1E1E1E}" StrokeShape="RoundRectangle 14,14,14,14" Stroke="Transparent" Padding="12,8">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Buscar" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}"/>
                    <Entry x:Name="SearchEntry" Placeholder="Buscar archivos..." PlaceholderColor="{AppThemeBinding Light=#888888, Dark=#7EC8FF}" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" HorizontalOptions="FillAndExpand" BackgroundColor="Transparent" TextChanged="OnSearchChanged"/>
                </HorizontalStackLayout>
            </Border>
            <Button Grid.Row="2" x:Name="PermissionBtn" Text="Dar permiso total para ver dentro de carpetas" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1E1E1E}" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" CornerRadius="12" Clicked="OnPermissionClicked" IsVisible="False"/>
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="+ Crear Carpeta" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1E1E1E}" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" CornerRadius="14" FontSize="13" FontAttributes="Bold" Padding="4,10" Clicked="OnCreateFolderClicked"/>
                <Button Grid.Column="1" Text="+ Crear Archivo" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1E1E1E}" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" CornerRadius="14" FontSize="13" FontAttributes="Bold" Padding="4,10" Clicked="OnCreateFileClicked"/>
            </Grid>
            <CollectionView Grid.Row="4" x:Name="FilesList" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F0F0F}" SelectionMode="Single" SelectionChanged="OnFileSelected" VerticalOptions="FillAndExpand" VerticalScrollBarVisibility="Always">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1E1E1E}" StrokeShape="RoundRectangle 14,14,14,14" Stroke="Transparent" Padding="12" Margin="0,0,0,8">
                            <HorizontalStackLayout Spacing="12">
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}" StrokeShape="RoundRectangle 12,12,12,12" Stroke="Transparent" WidthRequest="52" HeightRequest="52" VerticalOptions="Center" Padding="0">
                                    <Grid>
                                        <Path Data="{Binding IconGeometry}" Fill="{AppThemeBinding Light=Black, Dark=#7EC8FF}" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="28" HeightRequest="28" IsVisible="{Binding ShowDefaultIcon}"/>
                                        <Image Source="{Binding ApkIcon}" Aspect="AspectFill" IsVisible="{Binding HasApkIcon}"/>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Info}" TextColor="{AppThemeBinding Light=#666666, Dark=#7EC8FF}" Opacity="0.6" FontSize="12" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Carpeta vacia o sin permiso." TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" HorizontalOptions="Center" Margin="0,40,0,0"/>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="110" Color="{AppThemeBinding Light=White, Dark=#0F0F0F}"/>
                </CollectionView.Footer>
            </CollectionView>
        </Grid>
        <Label x:Name="StatusLabel" Text="" IsVisible="False" HeightRequest="0"/>
        <Border VerticalOptions="End" HorizontalOptions="FillAndExpand" Margin="16,0,16,28" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeShape="RoundRectangle 22,22,22,22" Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#333}" StrokeThickness="1" Padding="8" Shadow="0,5,20,#AAAAAA">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0" x:Name="BackBtn" Text="Atras" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333}" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" CornerRadius="14" FontSize="12" Padding="4,10" Clicked="OnBackClicked"/>
                <Button Grid.Column="1" x:Name="HomeBtn" Text="Inicio" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333}" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" CornerRadius="14" FontSize="12" Padding="4,10" Clicked="OnHomeClicked"/>
                <Button Grid.Column="2" x:Name="RefreshBtn" Text="Recargar" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333}" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" CornerRadius="14" FontSize="12" Padding="4,10" Clicked="OnRefreshClicked"/>
                <Button Grid.Column="3" x:Name="LangBtn" Text="Idioma" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#333}" TextColor="{AppThemeBinding Light=Black, Dark=#7EC8FF}" CornerRadius="14" FontSize="12" Padding="4,10" Clicked="OnChangeLangClicked"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
