<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OyeEscucha.MainPage"
             BackgroundColor="#0F0F0F">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Mis Archivos" FontSize="26" FontAttributes="Bold" TextColor="White"/>
        <Label x:Name="PathLabel" Text="/storage" FontSize="12" TextColor="#888888"/>

        <Frame BackgroundColor="#1E1E1E" CornerRadius="14" Padding="12,8" HasShadow="False" BorderColor="Transparent">
            <HorizontalStackLayout Spacing="10">
                <Label Text="🔍" FontSize="18" VerticalOptions="Center"/>
                <Entry x:Name="SearchEntry" Placeholder="Buscar archivos de verdad..." PlaceholderColor="#777777" TextColor="White" HorizontalOptions="FillAndExpand" BackgroundColor="Transparent" TextChanged="OnSearchChanged"/>
            </HorizontalStackLayout>
        </Frame>

        <HorizontalStackLayout Spacing="10">
            <Button x:Name="BackBtn" Text="⬅ Atrás" BackgroundColor="#333" TextColor="White" CornerRadius="12" Clicked="OnBackClicked"/>
            <Button Text="🏠 Inicio" BackgroundColor="#333" TextColor="White" CornerRadius="12" Clicked="OnHomeClicked"/>
            <Button Text="🔄 Recargar" BackgroundColor="#4CAF50" TextColor="White" CornerRadius="12" Clicked="OnRefreshClicked"/>
        </HorizontalStackLayout>

        <Label x:Name="StatusLabel" Text="Cargando..." TextColor="#888888" FontSize="13"/>

        <CollectionView x:Name="FilesList" SelectionMode="Single" SelectionChanged="OnFileSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#1E1E1E" CornerRadius="14" Padding="14" HasShadow="False" BorderColor="Transparent" Margin="0,0,0,8">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="{Binding Icon}" FontSize="26" VerticalOptions="Center"/>
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding Name}" TextColor="White" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Info}" TextColor="#888888" FontSize="12"/>
                            </VerticalStackLayout>
                            <Label Text="›" TextColor="#777777" FontSize="22" HorizontalOptions="EndAndExpand" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No hay archivos aquí o sin permiso. Dale a Recargar y acepta el permiso." TextColor="#888" HorizontalOptions="Center" Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
