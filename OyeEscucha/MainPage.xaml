<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OyeEscucha.MainPage"
             BackgroundColor="#0F0F0F">
    <Grid BackgroundColor="#0F0F0F">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,16,16,0" RowSpacing="10" BackgroundColor="#0F0F0F">
            
            <!-- ARRIBA -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" VerticalOptions="Center" BackgroundColor="#0F0F0F">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="TitleLabel" Text="Mis Archivos" FontSize="26" FontAttributes="Bold" TextColor="#7EC8FF"/>
                    <Label x:Name="PathLabel" Text="/storage" FontSize="12" TextColor="#7EC8FF" Opacity="0.7">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPathTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Toca la ruta para copiarla" FontSize="10" TextColor="#7EC8FF" Opacity="0.4"/>
                </VerticalStackLayout>

                <!-- SOL / LUNA DE ANTES - EN VECTOR, SIN EMOJI -->
                <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnThemeClicked"/></Grid.GestureRecognizers>
                    <!-- SOL -->
                    <Path x:Name="SunIcon" Data="M12 2 L12 5 M12 19 L12 22 M2 12 L5 12 M19 12 L22 12 M4.9 4.9 L7 7 M17 17 L19.1 19.1 M19.1 4.9 L17 7 M7 17 L4.9 19.1 M12 7 A5 5 0 1 1 12 17 A5 5 0 1 1 12 7 Z" Stroke="#FFD54F" StrokeThickness="2" Fill="Transparent" Aspect="Uniform" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False"/>
                    <!-- LUNA -->
                    <Path x:Name="MoonIcon" Data="M21 12.8 A9 9 0 1 1 11.2 3 A7 7 0 0 0 21 12.8 Z" Fill="#7EC8FF" Aspect="Uniform" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <Button Grid.Column="2" Text="•••" FontSize="20" TextColor="White" BackgroundColor="Transparent" WidthRequest="48" HeightRequest="48" Clicked="OnMenuClicked"/>
            </Grid>

            <!-- BUSCAR - ESCONDIDO -->
            <Border Grid.Row="1" x:Name="SearchBox" IsVisible="False" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 14,14,14,14" Stroke="Transparent" Padding="12,8">
                <HorizontalStackLayout Spacing="10">
                    <Path Data="M10 2 A8 8 0 1 1 10 18 A8 8 0 1 1 10 2 Z M15 15 L21 21" Stroke="#7EC8FF" StrokeThickness="2" Fill="Transparent" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                    <Entry x:Name="SearchEntry" Placeholder="Buscar archivos..." PlaceholderColor="#7EC8FF" TextColor="#7EC8FF" HorizontalOptions="FillAndExpand" BackgroundColor="Transparent" TextChanged="OnSearchChanged"/>
                    <Button Text="X" TextColor="#7EC8FF" BackgroundColor="Transparent" Clicked="OnCloseSearchClicked" WidthRequest="32"/>
                </HorizontalStackLayout>
            </Border>

            <Button Grid.Row="2" x:Name="PermissionBtn" Text="Dar permiso total para ver dentro de carpetas" BackgroundColor="#1E1E1E" TextColor="#7EC8FF" CornerRadius="12" Clicked="OnPermissionClicked" IsVisible="False"/>

            <!-- LISTA - FONDO NEGRO PARA QUE NO SALGA BLANCO AL FINAL -->
            <CollectionView Grid.Row="3" x:Name="FilesList" SelectionMode="Single" SelectionChanged="OnFileSelected" BackgroundColor="#0F0F0F" VerticalOptions="FillAndExpand">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 14,14,14,14" Stroke="Transparent" Padding="12" Margin="0,0,0,8">
                            <HorizontalStackLayout Spacing="12">
                                <Border BackgroundColor="#2A2A2A" StrokeShape="RoundRectangle 12,12,12,12" Stroke="Transparent" WidthRequest="52" HeightRequest="52" VerticalOptions="Center" Padding="4">
                                    <Grid>
                                        <Image Source="{Binding IconImage}" Aspect="AspectFit" IsVisible="{Binding ShowDefaultIcon}"/>
                                        <Image Source="{Binding ApkIcon}" Aspect="AspectFill" IsVisible="{Binding HasApkIcon}"/>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                    <Label Text="{Binding Name}" TextColor="#7EC8FF" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Info}" TextColor="#7EC8FF" Opacity="0.6" FontSize="12" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <!-- AQUI QUITE LOS ⋮ QUE NO TE GUSTABAN -->
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Carpeta vacia o sin permiso." TextColor="#7EC8FF" HorizontalOptions="Center" Margin="0,40,0,0"/>
                </CollectionView.EmptyView>
                <CollectionView.Footer><BoxView HeightRequest="110" Color="#0F0F0F"/></CollectionView.Footer>
            </CollectionView>
        </Grid>

        <Label x:Name="StatusLabel" Text="" IsVisible="False" HeightRequest="0"/>

        <!-- ABAJO - SIN FONDO BLANCO, TODO TRANSPARENTE -->
        <Grid VerticalOptions="End" HorizontalOptions="FillAndExpand" Margin="12,0,12,16" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" BackgroundColor="Transparent">
            <Border Grid.Column="0" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16,16,16,16" Stroke="#333" StrokeThickness="1" Padding="0">
                <Button x:Name="BackBtn" Text="Atras" BackgroundColor="Transparent" TextColor="#7EC8FF" FontSize="12" Padding="4,10" Clicked="OnBackClicked"/>
            </Border>
            <Border Grid.Column="1" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16,16,16,16" Stroke="#333" StrokeThickness="1" Padding="0">
                <Button x:Name="HomeBtn" Text="Inicio" BackgroundColor="Transparent" TextColor="#7EC8FF" FontSize="12" Padding="4,10" Clicked="OnHomeClicked"/>
            </Border>
            <Border Grid.Column="2" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16,16,16,16" Stroke="#333" StrokeThickness="1" Padding="0">
                <Button x:Name="RefreshBtn" Text="Recargar" BackgroundColor="Transparent" TextColor="#7EC8FF" FontSize="12" Padding="4,10" Clicked="OnRefreshClicked"/>
            </Border>
            <Border Grid.Column="3" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16,16,16,16" Stroke="#333" StrokeThickness="1" Padding="0">
                <Button x:Name="LangBtn" Text="Idioma" BackgroundColor="Transparent" TextColor="#7EC8FF" FontSize="12" Padding="4,10" Clicked="OnChangeLangClicked"/>
            </Border>
        </Grid>

        <!-- ALERTA MODERNA -->
        <Grid x:Name="ModernDialog" IsVisible="False" BackgroundColor="#80000000" Padding="24">
            <Border VerticalOptions="Center" HorizontalOptions="FillAndExpand" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 24,24,24,24" Stroke="Transparent" Padding="22">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="DialogTitle" Text="Titulo" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                    <Label x:Name="DialogMessage" Text="Mensaje" FontSize="14" TextColor="#AAAAAA"/>
                    <Entry x:Name="DialogEntry" IsVisible="False" BackgroundColor="#2A2A2A" TextColor="White" PlaceholderColor="#777777"/>
                    <VerticalStackLayout x:Name="DialogOptions" Spacing="8"/>
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                        <Button x:Name="DialogCancelBtn" Text="Cancelar" TextColor="#AAAAAA" BackgroundColor="Transparent" Clicked="OnDialogCancel"/>
                        <Button x:Name="DialogOkBtn" Text="Aceptar" TextColor="White" BackgroundColor="#3B82F6" CornerRadius="12" Clicked="OnDialogOk"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
