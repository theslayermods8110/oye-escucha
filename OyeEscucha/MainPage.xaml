<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OyeEscucha"
             x:Class="OyeEscucha.MainPage"
             BackgroundColor="#0F0F0F">
    <ContentPage.Resources>
        <local:IconConverter x:Key="IconConverter" />
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label x:Name="TitleLabel" Text="Mis Archivos" FontSize="26" FontAttributes="Bold" TextColor="#ADD8E6"/>
            <Label x:Name="PathLabel" Text="/storage" FontSize="12" TextColor="#ADD8E6" Opacity="0.7"/>
        </VerticalStackLayout>

        <Frame Grid.Row="1" BackgroundColor="#1E1E1E" CornerRadius="14" Padding="12,8" HasShadow="False" BorderColor="Transparent">
            <HorizontalStackLayout Spacing="10">
                <Label Text="Buscar" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" TextColor="#ADD8E6"/>
                <Entry x:Name="SearchEntry" Placeholder="Buscar archivos..." PlaceholderColor="#7FB5D5" TextColor="#ADD8E6" HorizontalOptions="FillAndExpand" BackgroundColor="Transparent" TextChanged="OnSearchChanged"/>
            </HorizontalStackLayout>
        </Frame>

        <!-- TODO EN UNA SOLA LINEA - 4 BOTONES JUNTOS -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" x:Name="BackBtn" Text="Atras" BackgroundColor="#333" TextColor="#ADD8E6" CornerRadius="10" FontSize="12" Padding="4,8" Clicked="OnBackClicked"/>
            <Button Grid.Column="1" x:Name="HomeBtn" Text="Inicio" BackgroundColor="#333" TextColor="#ADD8E6" CornerRadius="10" FontSize="12" Padding="4,8" Clicked="OnHomeClicked"/>
            <Button Grid.Column="2" x:Name="RefreshBtn" Text="Recargar" BackgroundColor="#4CAF50" TextColor="White" CornerRadius="10" FontSize="12" Padding="4,8" Clicked="OnRefreshClicked"/>
            <Button Grid.Column="3" x:Name="LangBtn" Text="Idioma" BackgroundColor="#222" TextColor="#ADD8E6" CornerRadius="10" FontSize="12" Padding="4,8" Clicked="OnChangeLangClicked"/>
        </Grid>

        <Button Grid.Row="3" x:Name="PermissionBtn" Text="Dar permiso total para ver dentro de carpetas" BackgroundColor="#FF9800" TextColor="Black" CornerRadius="12" Clicked="OnPermissionClicked" IsVisible="False"/>
        <Label Grid.Row="3" x:Name="StatusLabel" Text="Cargando..." TextColor="#ADD8E6" FontSize="13" Opacity="0.8" IsVisible="False"/>

        <CollectionView Grid.Row="4" x:Name="FilesList" SelectionMode="Single" SelectionChanged="OnFileSelected" VerticalOptions="FillAndExpand" VerticalScrollBarVisibility="Always">
            <CollectionView.Header>
                <Label x:Name="StatusLabel2" Text="Cargando..." TextColor="#ADD8E6" FontSize="13" Opacity="0.8" Margin="0,0,0,8"/>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 14,14,14,14" Stroke="Transparent" Padding="12" Margin="0,0,0,8">
                        <HorizontalStackLayout Spacing="12">
                            <Border BackgroundColor="{Binding BadgeColor}" StrokeShape="RoundRectangle 12,12,12,12" Stroke="Transparent" WidthRequest="52" HeightRequest="52" VerticalOptions="Center" Padding="11">
                                <Path Data="{Binding BadgeText, Converter={StaticResource IconConverter}}" Fill="White" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                <Label Text="{Binding Name}" TextColor="#ADD8E6" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Info}" TextColor="#ADD8E6" Opacity="0.6" FontSize="12"/>
                            </VerticalStackLayout>
                            <Label Text=">" TextColor="#ADD8E6" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Carpeta vacia o sin permiso. Dale al boton naranja." TextColor="#ADD8E6" HorizontalOptions="Center" Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
